{
  "name": "mwi-electron-desktop",
  "version": "0.1.0",
  "description": "Electron 桌面端多账号浏览器：在同一台电脑同时登录多个网页游戏账号，账号环境完全隔离，支持油猴脚本扩展，资源占用低且具备反关联能力",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "MWI_DEV=1 electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "multi-account",
    "browser",
    "userscript",
    "tampermonkey"
  ],
  "author": "shenhuanjie",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.mwi.desktop",
    "productName": "MWI Multi-Account Manager",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDownload": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "lib/**/*",
      "resources/**/*",
      "build/icon.icns",
      "build/icon.ico",
      "build/mwi.iconset/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tampermonkey",
        "to": "tampermonkey",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/logo.png",
        "to": "logo.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "resources/mihomo/macos",
          "to": "mihomo",
          "filter": [
            "mihomo",
            "mihomo-amd64"
          ]
        }
      ]
    },
    "executableName": "MWIMultiAccountManager",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "resources/mihomo/win",
          "to": "mihomo",
          "filter": [
            "mihomo.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "shortcutName": "MWI Multi-Account Manager"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "resources/mihomo/linux",
          "to": "mihomo",
          "filter": [
            "mihomo"
          ]
        }
      ]
    },
    "publish": null
  }
}
