{
  "name": "mwi-electron-desktop",
  "version": "0.1.4",
  "description": "Electron Desktop Multi-Account Browser: simultaneously log in to multiple web game accounts on the same computer, with completely isolated account environments, Tampermonkey script extension support, low resource consumption, and anti-association capabilities.",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs && electron .",
    "dev": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs && MWI_DEV=1 electron .",
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\" \"lib/__tests__/**/*.test.js\"",
    "test:modal": "node --test tests/modal-e2e.test.js",
    "test:lib": "node --test \"lib/__tests__/**/*.test.js\"",
    "test:e2e:lib": "electron lib/__tests__/clipboard-bridge.e2e.js && electron lib/__tests__/scrollbar-hide.e2e.js",
    "test:electron": "node tests/integration-electron.js show && node tests/integration-electron.js click && node tests/integration-electron.js esc",
    "test:tm-bg": "electron tests/tampermonkey-bg.e2e.js",
    "bump": "npm version --no-git-tag-version",
    "build:icons": "node scripts/build-icon-assets.mjs",
    "prepack": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs",
    "pretest": "node scripts/build-icon-assets.mjs",
    "dist": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs && electron-builder",
    "dist:mac": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs && electron-builder --mac",
    "dist:win": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs && electron-builder --win",
    "dist:linux": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs && electron-builder --linux",
    "dist:dir": "node scripts/build-icon-assets.mjs && node scripts/fetch-mihomo.mjs && electron-builder --dir"
  },
  "keywords": [
    "electron",
    "multi-account",
    "browser",
    "userscript",
    "tampermonkey"
  ],
  "author": {
    "name": "KUN"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenhuanjie/mwi-electron-desktop.git"
  },
  "homepage": "https://github.com/shenhuanjie/mwi-electron-desktop",
  "devDependencies": {
    "c8": "^12.0.0",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.6"
  },
  "build": {
    "appId": "com.mwi.desktop",
    "productName": "MWI Multi-Account Manager",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDownload": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "lib/**/*",
      "resources/**/*",
      "!resources/mihomo/**",
      "!resources/tampermonkey/**",
      "build/icon.icns",
      "build/icon.ico",
      "build/mwi.iconset/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tampermonkey",
        "to": "tampermonkey",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/logo.png",
        "to": "logo.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "resources/mihomo/macos",
          "to": "mihomo",
          "filter": [
            "mihomo",
            "mihomo-amd64"
          ]
        }
      ]
    },
    "executableName": "MWIMultiAccountManager",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "resources/mihomo/win",
          "to": "mihomo",
          "filter": [
            "mihomo.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "shortcutName": "MWI Multi-Account Manager"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "resources/mihomo/linux",
          "to": "mihomo",
          "filter": [
            "mihomo"
          ]
        }
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/shenhuanjie/mwi-electron-desktop/releases/download/"
    }
  }
}
